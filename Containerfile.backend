# Multi-stage build for the single Spring Boot artifact used by both
# process roles (api, worker) - see docs/01-c4-architecture.md.
FROM eclipse-temurin:21-jdk AS build
WORKDIR /src
COPY pom.xml .
COPY src ./src
RUN --mount=type=cache,target=/root/.m2 \
    apt-get update && apt-get install -y maven && \
    mvn -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /src/target/heimdall.jar app.jar
ENTRYPOINT ["java", "-jar", "app.jar"]

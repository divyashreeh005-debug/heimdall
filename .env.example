# Copy to .env and fill in before `docker compose up` / `podman-compose up`.

DB_URL=jdbc:postgresql://postgres:5432/heimdall
DB_USER=heimdall
DB_PASSWORD=change-me

JWT_SECRET=change-me-to-a-random-32-byte-string

GITHUB_APP_ID=
GITHUB_PRIVATE_KEY_PATH=/run/secrets/github-app-key.pem
GITHUB_WEBHOOK_SECRET=change-me
# Dev-only shortcut used by notification.* until the App installation-token
# exchange is implemented; leave blank to disable GitHub publishing entirely.
GITHUB_DEV_TOKEN=

OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_CHAT_MODEL=qwen2.5-coder:14b
OLLAMA_EMBED_MODEL=nomic-embed-text
